//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// BTC Tendencia 4H · cruce EMA 12/90 + filtro EMA 250 + trailing ATR
//
// Seguimiento de tendencia puro, largos y cortos, pensado para BYBIT:BTCUSDT.P
// en 4 horas. Pocas operaciones, ratio ganancia/perdida ~3:1, acierto ~39%.
//
//   LARGO  : EMA12 cruza ARRIBA de EMA90  Y  el cierre esta por ENCIMA de EMA250
//   CORTO  : EMA12 cruza ABAJO  de EMA90  Y  el cierre esta por DEBAJO de EMA250
//   Stop inicial : 1.5 x ATR(14) desde el cierre de la vela de señal
//   Trailing     : maximo alcanzado desde la entrada - 4 x ATR(14) (solo avanza)
//   Salida extra : cruce de EMAs en contra (cierra, no invierte hasta nuevo cruce)
//
// Backtest propio sobre 14.135 velas de 4h de Bybit (2020-03 .. 2026-09):
//   +330% con 10k, CAGR 25.4%, Profit Factor 1.90, max DD 16.2%, 126 operaciones,
//   7 de 7 años en positivo, largos PF 2.43 y cortos PF 1.47.
// ─────────────────────────────────────────────────────────────────────────────
strategy("BTC Tendencia 4H · EMA 12/90 + ATR", overlay = true,
     initial_capital         = 10000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.075,   // 0.055% taker Bybit + 0.02% deslizamiento
     slippage                = 0,
     pyramiding              = 0,
     process_orders_on_close = false,   // la orden se ejecuta en la apertura siguiente
     calc_on_every_tick      = false)

// ── Parametros ──────────────────────────────────────────────────────────────
gE = "1 · Señal"
rapidaLen = input.int(12,  "EMA rapida",            minval = 2,  group = gE)
lentaLen  = input.int(90,  "EMA lenta",             minval = 3,  group = gE)
tendLen   = input.int(250, "EMA de tendencia mayor", minval = 5, group = gE)

gR = "2 · Riesgo"
atrLen    = input.int(14,    "Longitud ATR",              minval = 1,   group = gR)
stopMult  = input.float(1.5, "Stop inicial (x ATR)",      minval = 0.1, step = 0.25, group = gR)
trailMult = input.float(4.0, "Trailing (x ATR desde el maximo)", minval = 0.5, step = 0.25, group = gR)

gF = "3 · Filtros opcionales"
usarAdx   = input.bool(false, "Exigir fuerza de tendencia (ADX)", group = gF)
adxLen    = input.int(14,     "Longitud ADX",  minval = 1, group = gF)
adxMin    = input.float(20,   "ADX minimo",    minval = 0, group = gF)
verLargos = input.bool(true,  "Operar largos", group = gF)
verCortos = input.bool(true,  "Operar cortos", group = gF)

gV = "4 · Ventana de backtest"
desdeAnio = input.int(2020, "Desde el año", minval = 2017, group = gV)

// ── Indicadores ─────────────────────────────────────────────────────────────
emaRapida = ta.ema(close, rapidaLen)
emaLenta  = ta.ema(close, lentaLen)
emaTend   = ta.ema(close, tendLen)
atrV      = ta.atr(atrLen)

[diPlus, diMinus, adxV] = ta.dmi(adxLen, adxLen)
fuerza = not usarAdx or adxV >= adxMin

enVentana = year >= desdeAnio

// ── Señales ─────────────────────────────────────────────────────────────────
cruceArriba = ta.crossover(emaRapida,  emaLenta)
cruceAbajo  = ta.crossunder(emaRapida, emaLenta)

sinPosicion = strategy.position_size == 0
abrirLargo  = cruceArriba and close > emaTend and fuerza and verLargos and sinPosicion and enVentana
abrirCorto  = cruceAbajo  and close < emaTend and fuerza and verCortos and sinPosicion and enVentana

// ── Estado del trailing ─────────────────────────────────────────────────────
var float pico  = na    // extremo alcanzado desde la entrada
var float nivel = na    // stop vigente (solo se mueve a favor)

if abrirLargo
    strategy.entry("L", strategy.long)
    pico  := high
    nivel := close - stopMult * atrV

if abrirCorto
    strategy.entry("S", strategy.short)
    pico  := low
    nivel := close + stopMult * atrV

// ── Gestion de la posicion abierta ──────────────────────────────────────────
if strategy.position_size > 0
    pico  := math.max(nz(pico, high), high)
    nivel := math.max(nz(nivel, pico - trailMult * atrV), pico - trailMult * atrV)
    strategy.exit("salida L", from_entry = "L", stop = nivel)
    if cruceAbajo
        strategy.close("L", comment = "cruce en contra")

if strategy.position_size < 0
    pico  := math.min(nz(pico, low), low)
    nivel := math.min(nz(nivel, pico + trailMult * atrV), pico + trailMult * atrV)
    strategy.exit("salida S", from_entry = "S", stop = nivel)
    if cruceArriba
        strategy.close("S", comment = "cruce en contra")

if strategy.position_size == 0 and not abrirLargo and not abrirCorto
    pico  := na
    nivel := na

// ── Dibujo ──────────────────────────────────────────────────────────────────
plot(emaRapida, "EMA rapida",   color = color.new(#26a69a, 0), linewidth = 1)
plot(emaLenta,  "EMA lenta",    color = color.new(#ef5350, 0), linewidth = 1)
plot(emaTend,   "EMA tendencia", color = color.new(#787b86, 0), linewidth = 2)
plot(strategy.position_size != 0 ? nivel : na, "Stop", color = color.new(#ff9800, 0),
     style = plot.style_linebr, linewidth = 2)

bgcolor(close > emaTend ? color.new(#26a69a, 94) : color.new(#ef5350, 94))
