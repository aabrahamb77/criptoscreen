//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// BTC SCALP 5m · reversion por z-score a favor de la tendencia
//
// El diseño NO sale de probar indicadores al azar: se midio primero el mercado.
// En BTC intradia la "continuacion" (que una vela siga a la anterior) es del
// 47,4%, y esta POR DEBAJO del 50% en las 24 horas del dia. Es decir, BTC en
// temporalidad baja es REVERSIVO siempre. Esta estrategia explota justo eso, y
// por eso las de ruptura/momentum en 5-15m pierden dinero de forma sistematica.
//
//   LARGO  : z <= -2.5  Y  cierre por ENCIMA de la EMA 200   (caida extrema en tendencia alcista)
//   CORTO  : z >= +2.5  Y  cierre por DEBAJO de la EMA 200   (subida extrema en tendencia bajista)
//   z = (cierre - SMA 100) / desviacion tipica 100
//   Salida : el precio vuelve a su media (z cruza 0)
//   Stop   : 3 x ATR(14)
//
// AVISO IMPORTANTE SOBRE COMISIONES:
//   Esta estrategia SOLO es rentable con ordenes LIMITE (maker, 0,02% en Bybit).
//   Con ordenes a mercado (taker, 0,055%) el Profit Factor cae de 1,75 a 1,26 y
//   el walk-forward pasa de 5/5 a 4/5 ventanas positivas. La comision no es un
//   detalle aqui: es la diferencia entre ganar y no ganar.
//   Entrar con limite es natural en esta estrategia (se compra una caida a
//   -2,5 sigma: se deja la orden puesta y se espera a que el precio llegue).
//
// Backtest propio sobre 492.286 velas de 5m de Bybit (2022-01 .. 2026-09):
//   maker: +21,1% sin apalancar, PF 1,75, DD 3,0%, 114 ops, 62,3% aciertos,
//          walk-forward 5/5 ventanas positivas, Monte Carlo p5 +7,5%.
//   con apalancamiento x4: CAGR 16,9%, DD 12,0%, peor operacion -5,36%.
// ─────────────────────────────────────────────────────────────────────────────
strategy("BTC Scalp 5m · reversion z-score", overlay = true,
     initial_capital         = 10000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,     // 100 = sin apalancar. 400 = x4.
     commission_type         = strategy.commission.percent,
     commission_value        = 0.025,   // 0,02% maker Bybit + 0,005% deslizamiento
     slippage                = 0,
     pyramiding              = 0,
     process_orders_on_close = false,
     calc_on_every_tick      = false)

// ── Parametros ──────────────────────────────────────────────────────────────
gS = "1 · Señal"
zLen     = input.int(100, "Velas para la media y la desviacion", minval = 5,  group = gS)
zEntrada = input.float(2.5, "Desviaciones para entrar",  minval = 0.5, step = 0.25, group = gS)
zSalida  = input.float(0.0, "Desviaciones para salir",   minval = 0.0, step = 0.25, group = gS)
tendLen  = input.int(200, "EMA de tendencia (filtro)",   minval = 5,  group = gS)

gR = "2 · Riesgo"
atrLen   = input.int(14,    "Longitud ATR",       minval = 1,   group = gR)
stopMult = input.float(3.0, "Stop (x ATR)",       minval = 0.5, step = 0.25, group = gR)
maxVelas = input.int(0, "Salir tras N velas (0 = sin limite)", minval = 0, group = gR)

gF = "3 · Filtros"
verLargos = input.bool(true, "Operar largos", group = gF)
verCortos = input.bool(true, "Operar cortos", group = gF)

// ── Indicadores ─────────────────────────────────────────────────────────────
base   = ta.sma(close, zLen)
desv   = ta.stdev(close, zLen)
z      = desv > 0 ? (close - base) / desv : 0.0
tend   = ta.ema(close, tendLen)
atrV   = ta.atr(atrLen)

// ── Señales ─────────────────────────────────────────────────────────────────
sinPosicion = strategy.position_size == 0
abrirLargo  = sinPosicion and verLargos and z <= -zEntrada and close > tend
abrirCorto  = sinPosicion and verCortos and z >=  zEntrada and close < tend

var float nivelStop = na
var int   velasEnPos = 0

if abrirLargo
    strategy.entry("L", strategy.long)
    nivelStop  := close - stopMult * atrV
    velasEnPos := 0

if abrirCorto
    strategy.entry("S", strategy.short)
    nivelStop  := close + stopMult * atrV
    velasEnPos := 0

// ── Gestion ─────────────────────────────────────────────────────────────────
if strategy.position_size > 0
    velasEnPos += 1
    strategy.exit("salida L", from_entry = "L", stop = nivelStop)
    if z >= -zSalida
        strategy.close("L", comment = "vuelta a la media")
    else if maxVelas > 0 and velasEnPos >= maxVelas
        strategy.close("L", comment = "tiempo agotado")

if strategy.position_size < 0
    velasEnPos += 1
    strategy.exit("salida S", from_entry = "S", stop = nivelStop)
    if z <= zSalida
        strategy.close("S", comment = "vuelta a la media")
    else if maxVelas > 0 and velasEnPos >= maxVelas
        strategy.close("S", comment = "tiempo agotado")

if strategy.position_size == 0 and not abrirLargo and not abrirCorto
    nivelStop  := na
    velasEnPos := 0

// ── Dibujo ──────────────────────────────────────────────────────────────────
plot(base, "Media", color = color.new(#787b86, 0), linewidth = 1)
plot(base - zEntrada * desv, "Banda inferior", color = color.new(#26a69a, 30))
plot(base + zEntrada * desv, "Banda superior", color = color.new(#ef5350, 30))
plot(tend, "EMA tendencia", color = color.new(#2962ff, 0), linewidth = 2)
plot(strategy.position_size != 0 ? nivelStop : na, "Stop",
     color = color.new(#ff9800, 0), style = plot.style_linebr, linewidth = 2)

bgcolor(close > tend ? color.new(#26a69a, 95) : color.new(#ef5350, 95))
